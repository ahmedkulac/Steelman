# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Using SQLite for development (no setup required!)
# For production, switch to PostgreSQL and update DATABASE_URL
DATABASE_URL="file:./dev.db"

# For PostgreSQL (uncomment and configure if using):
# DATABASE_URL=postgresql://user:password@localhost:5432/hackathon_db?schema=public

# JWT Authentication (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (optional - in-memory cache used as fallback)
# Set REDIS_ENABLED=false to use in-memory cache only (no Redis needed)
# Set REDIS_ENABLED=true and configure REDIS_URL to use Redis + memory cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Note: App works fine without Redis - uses fast in-memory cache automatically

# Google Gemini API
# Shared API key for this project - you can use this or get your own
# Get your own key from: https://makersuite.google.com/app/apikey
# Required for AI functionality
GOOGLE_API_KEY=AIzaSyAUUiKmrSVckd9jeBp6plG4rvxjfuuYgUY
# Alternative: GEMINI_API_KEY (either GOOGLE_API_KEY or GEMINI_API_KEY works)
# GEMINI_API_KEY=

# AI Model Configuration
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2000

# Rate Limiting (adjusted for free tier)
# Free tier: 15 requests per minute (RPM)
# Our limit: 10 requests per hour per IP (more conservative)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10
