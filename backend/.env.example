# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Using SQLite for development (no setup required!)
# For production, switch to PostgreSQL and update DATABASE_URL
DATABASE_URL="file:./dev.db"

# For PostgreSQL/Supabase (uncomment and configure if using):
# Get connection string from: Supabase Dashboard → Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# For connection pooling (recommended): use port 6543
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true

# JWT Authentication (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (optional - in-memory cache used as fallback)
# Set REDIS_ENABLED=false to use in-memory cache only (no Redis needed)
# Set REDIS_ENABLED=true and configure REDIS_URL to use Redis + memory cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Note: App works fine without Redis - uses fast in-memory cache automatically

# OpenRouter API
# Get your API key from: https://openrouter.ai/keys
# Required for AI functionality
OPENROUTER_API_KEY=Sk-or-v1-e1bc52f5bdffc6ba167ec870ba0f9b752d56d04c8f53d1f952970872f59e1cd0

# AI Model Configuration
# Default model: google/gemini-2.0-flash-001 (via OpenRouter)
# Other options: anthropic/claude-3.5-sonnet, openai/gpt-4, etc.
# See: https://openrouter.ai/models
AI_MODEL=google/gemini-2.0-flash-001
AI_MAX_TOKENS=2000

# Site Information (for OpenRouter)
SITE_URL=http://localhost:3000
SITE_NAME=Steelman

# Rate Limiting (adjusted for free tier)
# Free tier: 15 requests per minute (RPM)
# Our limit: 10 requests per hour per IP (more conservative)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10
