# Backend Environment Variables - Supabase Configuration
# Copy this file to .env and fill in your Supabase values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database - Supabase PostgreSQL
# Get this from: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For connection pooling (recommended): use port 6543 instead of 5432
DATABASE_URL="postgresql://postgres:your-password@db.abcdefghijklmnop.supabase.co:5432/postgres"

# Connection Pooling (Optional - Better Performance)
# Use this instead of DATABASE_URL for better connection handling:
# DATABASE_URL="postgresql://postgres:your-password@db.xxx.supabase.co:6543/postgres?pgbouncer=true"

# JWT Authentication (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (optional - disable if not using Redis)
# Supabase doesn't provide Redis, so use in-memory cache or external Redis
REDIS_ENABLED=false
# If using external Redis:
# REDIS_URL=redis://your-redis-url:6379

# Google Gemini API
# Required for AI functionality
GOOGLE_API_KEY=AIzaSyAUUiKmrSVckd9jeBp6plG4rvxjfuuYgUY
# Alternative: GEMINI_API_KEY (either GOOGLE_API_KEY or GEMINI_API_KEY works)
# GEMINI_API_KEY=

# AI Model Configuration
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2000

# Rate Limiting (adjusted for free tier)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10

# CORS - Add your frontend URLs
# For Vercel deployment, add your Vercel URL here
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
