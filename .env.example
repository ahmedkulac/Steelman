# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hackathon_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (optional - disable if not using Redis)
# Set REDIS_ENABLED=false to disable Redis entirely
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# External APIs (add your keys here)
# Google Gemini API - Get your key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=
# Alternative: GEMINI_API_KEY (either GOOGLE_API_KEY or GEMINI_API_KEY works)
# GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10

# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=
