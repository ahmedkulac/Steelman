{
  "name": "hackathon-starter",
  "version": "1.0.0",
  "description": "A comprehensive hackathon starter template",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "clean:nextjs": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-nextjs.ps1"
  },
  "keywords": [
    "hackathon",
    "starter",
    "template",
    "nextjs",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
